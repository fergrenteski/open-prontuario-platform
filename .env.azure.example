# Copie para .env.azure (fora do git) e preencha as 3 primeiras linhas.
# INTERNAL_API_KEY, JWT_SECRET e SQL_ADMIN_PASSWORD são gerados na 1ª execução do scripts/azure.sh.

DOCKERHUB_USER=
# Connection string do Atlas: mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
APIM_EMAIL=

# Opcionais
RG=rg-openprontuario
LOCATION=brazilsouth
IMAGE_TAG=v1
