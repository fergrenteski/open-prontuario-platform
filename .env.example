# Copie para .env (o `make up` faz isso se o arquivo não existir).
# Valores SOMENTE para desenvolvimento local — nunca reutilize em nuvem.

# SQL Server local (compartilhado pelo MS Fila e pelo Service Bus Emulator).
# Precisa atender à política de senha do SQL Server (8+ caracteres, maiúscula, minúscula, número, símbolo).
MSSQL_SA_PASSWORD=Prontuario@Local123

# Segredo compartilhado entre BFF, microserviços e Function (header X-Internal-Key).
INTERNAL_API_KEY=dev-internal-key-troque-em-nuvem

# Assinatura HS256 dos tokens do modo dev do BFF.
JWT_SECRET=dev-jwt-secret-com-pelo-menos-32-caracteres!!
